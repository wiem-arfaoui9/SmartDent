# ------------------------------------------------------------------
# SmartDent - variables Docker Compose
# Copier vers .env :  powershell -File scripts/init-env.ps1
# (génère automatiquement APP_KEY et les mots de passe)
# NE JAMAIS COMMITER le fichier .env
# ------------------------------------------------------------------

# Port HTTP exposé sur la machine hôte (http://localhost:8080)
WEB_PORT=8080

# Base de données MySQL
DB_DATABASE=smartdent
DB_USERNAME=smartdent
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Clé Laravel (format base64:...)
APP_KEY=

# true = charge les comptes de test au démarrage (si la base est vide)
RUN_SEED=true

# warning (production) | debug (diagnostic)
LOG_LEVEL=warning

# Optionnel : résumés médicaux IA
ANTHROPIC_API_KEY=
